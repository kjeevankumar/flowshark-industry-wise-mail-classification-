# Gmail Credentials
# For Gmail App Password, enable 2FA on your Google Account:
# Go to https://myaccount.google.com/apppasswords
# Generate a 16-character App Password (e.g., "abcd efgh ijkl mnop")
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# IMAP Configuration (Incoming Mail)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TIMEOUT_SECONDS=30

# SMTP Configuration (Outgoing Mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TIMEOUT_SECONDS=30

# Background Synchronization
SYNC_INTERVAL_SECONDS=30
BACKGROUND_SYNC_ENABLED=true

# Database Configuration (SQLite by default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/flowshark.db

# AI / LLM Configuration
# Options: "gemini" | "openai" | "fallback"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Classification Thresholds
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.60

# Application Settings
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
